# Server-only (no NEXT_PUBLIC_ prefix — the browser never talks to Supabase
# directly, only to our own /api/waitlist route handler).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Public, inlined at build time. The App Store listing URL; leave empty until
# the app is live. Unset, every App Store button renders "Coming soon on the
# App Store" (not a link) with the waitlist form beneath it.
NEXT_PUBLIC_APP_STORE_URL=
