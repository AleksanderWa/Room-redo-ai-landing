# Supabase, read server-side only by /api/waitlist (the browser never talks
# to Supabase directly). Use the ANON key only, never the service-role key.
# The Vercel Supabase integration creates the STORAGE_-prefixed names; the
# plain names below them are a fallback for local setups. Names only here;
# real values go in .env.local / Vercel, never in the repo.
NEXT_PUBLIC_STORAGE_SUPABASE_URL=
STORAGE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Public, inlined at build time. The App Store listing URL; leave empty until
# the app is live. Unset, every App Store button renders "Coming soon on the
# App Store" (not a link) with the waitlist form beneath it.
NEXT_PUBLIC_APP_STORE_URL=

# Public, inlined at build time. The App Store Connect provider token (the
# `pt` in campaign links). Article CTAs link to
# https://apps.apple.com/app/apple-store/id6812385415?pt=<token>&ct=article-<slug>&mt=8
# so App Store Connect shows installs per article. Unset, they use the plain
# NEXT_PUBLIC_APP_STORE_URL with no tracking parameters.
NEXT_PUBLIC_APP_STORE_PROVIDER_TOKEN=

# Public, inlined at build time. Product analytics + session replay. Leave
# NEXT_PUBLIC_POSTHOG_KEY empty to disable it entirely (dev/CI). Events are
# sent through the same-origin /ingest rewrite in next.config.ts, which
# proxies to the US cloud host.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
